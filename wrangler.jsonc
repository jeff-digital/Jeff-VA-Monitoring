{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeff-va-monitoring",
  "main": "src/backend/worker.mjs",
  "compatibility_date": "2026-10-08",
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "FOLLOW_UP_DELIVERIES", "class_name": "FollowUpDelivery" }] },
  "migrations": [{ "tag": "follow-up-delivery-v1", "new_sqlite_classes": ["FollowUpDelivery"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://oeooedwobhmpwwdohrcy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_avqScHW52sfzxgl_e1aqEQ_Wk6FRGAU"
  }
}
